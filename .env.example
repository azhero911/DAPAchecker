# DAPA Metrics Environment Configuration

# Provider Selection: 'mock' | 'openpagerank' | 'moz' | 'dataforseo'
METRICS_PROVIDER=mock

# OpenPageRank API (Free: https://www.domcop.com/openpagerank/)
OPR_API_KEY=

# Moz API v2 (Optional: https://moz.com/products/api)
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# Upstash Redis (Free: https://upstash.com/)
# If omitted, application automatically uses high-speed in-memory cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configurable Limits (Overrides defaults in src/config/limits.ts)
MAX_DOMAINS_PER_BATCH=10
RATE_LIMIT_PER_MINUTE=5
CACHE_TTL_DAYS=7

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Arham123$@we

# Site URL for canonical & OpenGraph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
